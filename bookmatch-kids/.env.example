# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API (required for recommendations)
ANTHROPIC_API_KEY=

# Google Books (optional — public API works without a key, but rate-limited)
GOOGLE_BOOKS_API_KEY=

# Site URL (used for OAuth + Stripe redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs (populate with `node scripts/stripe-setup.mjs`)
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_ANNUAL=
STRIPE_PRICE_FAMILY_PLUS_MONTHLY=
STRIPE_PRICE_FAMILY_PLUS_ANNUAL=
STRIPE_PRICE_GROUP_STARTER_ANNUAL=
STRIPE_PRICE_GROUP_PLUS_ANNUAL=
STRIPE_PRICE_GROUP_PRO_ANNUAL=
