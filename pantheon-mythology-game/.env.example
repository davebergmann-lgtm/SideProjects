# Firebase Configuration for PANTHEON cross-device sync
# -------------------------------------------------------
# 1. Go to https://console.firebase.google.com and create a project
# 2. Add a Web App (Project Settings → Your Apps → </> icon)
# 3. Copy the firebaseConfig values below
# 4. Create a Firestore database (Build → Firestore Database → Start in test mode)
# 5. Copy this file to .env and fill in your values

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# For GitHub Pages deployment, add these as repository secrets:
# Settings → Secrets and variables → Actions → New repository secret
# Then reference them in your GitHub Actions workflow.
#
# Recommended Firestore security rules (Firebase Console → Firestore → Rules):
#
# rules_version = '2';
# service cloud.firestore {
#   match /databases/{database}/documents {
#     match /players/{username} {
#       allow read, write: if true;
#     }
#   }
# }
